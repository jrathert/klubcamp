# Generic reference: create production.env beside the deployed app/ directory.
# See docs/deployment.md for the runtime contract and docs/deployment-hetzner.md
# for current provider-specific paths, listener settings, and Azure SMTP values.
# Never use local development credentials. chmod 600 production.env.
NODE_ENV=production
# Example internal listener; confirm the hosting platform's routing contract.
HOST=127.0.0.1
PORT=3000
DB_HOST=replace-with-hosted-database-host
DB_PORT=3306
DB_NAME=replace-with-database-name
DB_USER=replace-with-non-root-user
DB_PASSWORD="replace-with-private-password"
SMTP_MODE=smtp
SMTP_HOST=replace-with-verified-smtp-host
# Example STARTTLS service: false means TLS after connecting, NOT unencrypted mail.
# Our production SMTP implementation requires the STARTTLS upgrade.
# true means immediate/implicit TLS (usually 465); verify the mail service's settings.
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace-with-smtp-user
SMTP_PASSWORD="replace-with-private-password"
SMTP_FROM=replace-with-authorized-sender@example.org

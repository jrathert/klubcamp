# Copy to .env; use disposable local credentials. Never commit real credentials.
HOST=127.0.0.1
PORT=3000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=klubcamp
DB_USER=klubcamp
DB_PASSWORD=replace-local-password
DB_ROOT_PASSWORD=replace-local-root-password
# Local Mailpit only: captures email; no TLS, authentication, or external delivery.
SMTP_MODE=mailpit
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
MAILPIT_UI_PORT=8025
# In mailpit mode this must be false and credentials must remain empty.
# Production: SMTP_MODE=smtp, verified host/credentials; false requires STARTTLS,
# true selects implicit TLS (typically port 465).
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=klubcamp@example.test
